# Example environment configuration for the expense tracker.
# Copy to `.env` and fill in real values. The `.env` file itself is gitignored
# (see .gitignore) — never commit real secrets.

# Runtime mode: "desktop" (SQLite + pywebview) or "hosted" (Postgres + OAuth).
APP_MODE=desktop

# Postgres connection string. Required in hosted mode; leave empty for desktop.
DATABASE_URL=

# Secret used to sign Flask session cookies. Generate a long random value in prod.
FLASK_SECRET_KEY=dev-insecure-secret-change-me

# Google OAuth client credentials (hosted mode auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL used to build the OAuth callback (no trailing slash).
OAUTH_REDIRECT_BASE=http://localhost:5050

# Comma-separated allowlist of Google emails that are auto-approved (skip the
# pending queue). Empty = new users start as pending. Example: a@x.com,b@y.com
ALLOWED_EMAILS=

# Comma-separated admin emails (auto-approved, can review requests, receive the
# access-request emails below). Example: you@example.com
ADMIN_EMAILS=

# Port the Flask server listens on.
PORT=5050

# Set to 1 to enable Flask debug mode.
FLASK_DEBUG=0

# SMTP for access-request emails (e.g. Gmail App Password).
# Leave any of HOST/USER/PASS empty to disable mailing (sending becomes a no-op).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your-gmail>,
#        SMTP_PASS=<16-char app password>. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Enable Banking (hosted Open Banking import). Get the application id + key from
# the Enable Banking developer portal, upload the PUBLIC key there, and put the
# base64-encoded PRIVATE key PEM here. Generate the base64 with:
#   base64 -i path/to/private_key.pem | tr -d '\n'
# Register the redirect URI <OAUTH_REDIRECT_BASE>/api/import/bank/callback in the
# EB app config. Leave empty to disable the bank-import feature.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_ASPSP=Nordea
ENABLE_BANKING_COUNTRY=FI
