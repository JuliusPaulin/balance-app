# Example environment configuration for Balance.
# Copy to `.env` and fill in real values. The `.env` file itself is gitignored
# (see .gitignore) — never commit real secrets.
#
# Every setting here is optional: with no .env at all, Balance runs against
# ~/Library/Application Support/Balance/expenses.db on port 5050.

# Where the database file lives. Uncomment only to move it.
# SQLITE_PATH=

# Secret used to sign the local Flask session cookie (it carries only the CSRF
# token). Any long random value will do.
FLASK_SECRET_KEY=dev-insecure-secret-change-me

# Port the local Flask server listens on.
PORT=5050

# Set to 1 to enable Flask debug mode.
FLASK_DEBUG=0

# Enable Banking (optional Open Banking import). Get the application id + key
# from the Enable Banking developer portal, upload the PUBLIC key there, and put
# the base64-encoded PRIVATE key PEM here. Generate the base64 with:
#   base64 -i path/to/private_key.pem | tr -d '\n'
# Register the redirect URI <BANK_REDIRECT_BASE>/api/import/bank/callback in the
# EB app config. Leave empty to disable the bank-import feature.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_ASPSP=Nordea
ENABLE_BANKING_COUNTRY=FI

# Where the bank sends the browser back after consent. Defaults to this app's
# own address, http://localhost:<PORT>. Uncomment only to change it.
# BANK_REDIRECT_BASE=
